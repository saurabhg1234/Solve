# Server variables only. Never prefix these with NEXT_PUBLIC_.
ZORA_APP_URL=http://localhost:3000
DATABASE_URL=
ZORA_SESSION_SECRET=
ZORA_RUNNER_TOKEN=
ZORA_WEBHOOK_SECRET=
# Optional Vercel automation bypass for the Microsoft callback only.
ZORA_NOTIFICATION_BYPASS=
CRON_SECRET=

# Existing cloud variable names are supported as aliases.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SERVICE_PRINCIPAL_OBJECT_ID=
# Aliases: Tenant, Client, Client_secret, Object, EMAIL
MS_ZORA_MAILBOX=apex.ap@mindmapdigital.ai
MS_ZORA_FOLDER_ID=
ZORA_SUBJECT_TAG=[ZORA]

# Comma-separated work email addresses; an empty list denies sign-in.
ZORA_ALLOWED_EMAILS=
# JSON map of work emails to BRD roles; do not grant pricing roles to everyone.
ZORA_ROLE_MAP={}

# Deploy tooling only: never expose VERCEL_TOKEN to the web application.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional worker settings. The worker runs outside Vercel with Codex sign-in.
ZORA_WORKER_ID=
ZORA_WORK_ROOT=
ZORA_REPO_ROOT=
